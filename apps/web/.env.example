# Finlume web configuration — TEMPLATE ONLY. Copy to `.env.local` (git-ignored).
# No secrets belong here: every VITE_* value is compiled into the public bundle.

# Origin of the Finlume API as seen by the browser. Leave EMPTY for the
# standard same-origin setup: the browser calls /api/v1/... on the web app's
# own origin (Vite's dev proxy locally, the reverse proxy in production).
# Only set it when the API lives on another origin, which also requires
# CORS and CSRF configuration on the backend (not provided today).
VITE_API_BASE_URL=

# Development and preview servers only (never exposed to the browser): where
# Vite forwards /api requests. Defaults to the local Django server.
FINLUME_API_PROXY_TARGET=http://127.0.0.1:8000
