# Finlume mobile configuration — TEMPLATE ONLY. Copy to `.env` (git-ignored).
#
# EXPO_PUBLIC_* values are compiled into the app bundle and visible to anyone
# who has the app. Never put secrets here.

# Base URL of the Django server, reachable FROM THE DEVICE (not 127.0.0.1 on a
# phone). Example for a dev machine on your LAN: http://192.168.1.20:8000
# Leave empty to run without a backend (the app shows "Not configured").
EXPO_PUBLIC_API_BASE_URL=
