# Finlume environment configuration — TEMPLATE ONLY.
#
# Copy to `.env` in the repository root (git-ignored) and replace every
# placeholder. Never commit a real `.env`. Real environment variables always
# take precedence over values in this file.
# Reference: docs/development/LOCAL_SETUP.md

# --- Django -----------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Optional in development (a random per-process key is used when unset).
# Required, and at least 50 characters, in production.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins, e.g. https://finlume.example.org (comma-separated)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# PostgreSQL is Finlume's database and the development default. Startup fails
# with a clear message if the POSTGRES_* values below are missing; there is no
# automatic fallback. "sqlite" is an explicit opt-in for throwaway trials only
# (it does not preserve decimal precision like PostgreSQL); production refuses it.
FINLUME_DB_ENGINE=postgresql
POSTGRES_DB=finlume
POSTGRES_USER=finlume
# Used both by Django and by compose.yaml's development database container.
POSTGRES_PASSWORD=replace-with-a-local-password
# Use 127.0.0.1, not "localhost": on Windows, localhost resolves to IPv6 ::1
# first, and compose.yaml's container listens on IPv4 only, so every
# connection would stall until the IPv6 attempt times out.
POSTGRES_HOST=127.0.0.1
# Host port of compose.yaml's container AND Django's connection. 55432 avoids
# PostgreSQL servers commonly installed on 5432/5433. Pointing it at another
# server makes Django use that server instead; only use databases you own.
POSTGRES_PORT=55432
POSTGRES_SSLMODE=prefer
# Seconds before a connection attempt fails, instead of hanging.
POSTGRES_CONNECT_TIMEOUT=5

# --- Tests ------------------------------------------------------------------
# Database for pytest, independent of FINLUME_DB_ENGINE. "sqlite" (default)
# runs isolated in memory. "postgresql" uses the POSTGRES_* server above and
# creates, then drops, a database named test_<POSTGRES_DB> on it. CI always
# runs the suite on PostgreSQL.
FINLUME_TEST_DB_ENGINE=sqlite

# --- Storage and limits -----------------------------------------------------
# Absolute path outside any web-served directory. Defaults to backend/var/private.
FINLUME_PRIVATE_STORAGE_ROOT=
FINLUME_MAX_REQUEST_BYTES=5242880

# --- Operations -------------------------------------------------------------
FINLUME_LOG_LEVEL=INFO
FINLUME_ADMIN_URL_PATH=admin/
FINLUME_THROTTLE_ANON=60/minute
FINLUME_THROTTLE_USER=1000/hour
# Sign-in attempts, per client IP and per email address.
FINLUME_THROTTLE_LOGIN_IP=5/minute
FINLUME_THROTTLE_LOGIN_EMAIL=5/minute
# Sessions end after this many seconds of inactivity (8 hours).
FINLUME_SESSION_AGE_SECONDS=28800

# --- Production HTTPS (ignored by development settings) ----------------------
FINLUME_SECURE_SSL_REDIRECT=true
# Only behind a reverse proxy that terminates TLS and sets X-Forwarded-Proto.
FINLUME_TRUST_PROXY_SSL_HEADER=false
# Enable HSTS only once HTTPS works for every host; start small (e.g. 3600).
FINLUME_HSTS_SECONDS=0
FINLUME_HSTS_INCLUDE_SUBDOMAINS=false
FINLUME_HSTS_PRELOAD=false
